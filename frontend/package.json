{
  "name": "roommind-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "dev:room-detail": "bun --bun vite --host 127.0.0.1 --open /dev/room-detail-preview.html",
    "typecheck": "bun --bun tsgo --noEmit",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "preview:regression": "bun scripts/preview-regression.ts",
    "lint": "bun --bun eslint src/",
    "format": "bun --bun prettier --write src/",
    "format:check": "bun --bun prettier --check src/"
  },
  "dependencies": {
    "home-assistant-js-websocket": "^9.4.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.56.1",
    "@typescript/native-preview": "7.0.0-dev.20260524.1",
    "eslint": "^10.2.1",
    "eslint-plugin-lit": "^2.2.1",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "vite": "^8.0.11"
  }
}
