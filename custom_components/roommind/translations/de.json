    "binary_sensor": {
      "cover_paused": {
        "name": "{room} Rollosteuerung pausiert"
      }
    },
    "switch": {
      "cover_auto": {
        "name": "{room} Rollos automatisch"
      },
      "climate_control": {
        "name": "{room} Klimasteuerung"
      },
      "vacation_mode": {
        "name": "Urlaubsmodus"
      }
    },
    "climate": {
      "override": {
        "name": "{room} Übersteuerung"
      }
    }
  }
