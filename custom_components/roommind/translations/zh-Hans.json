{
  "config": {
    "step": {
      "user": {
        "title": "RoomMind",
        "description": "设置 RoomMind 以管理房间温控。安装完成后，可在 RoomMind 面板中配置房间。"
      }
    },
    "abort": {
      "already_configured": "RoomMind 已经配置过了。"
    }
  },
  "issues": {
    "restart_required": {
      "title": "需要重启",
      "fix_flow": {
        "step": {
          "confirm_restart": {
            "title": "重启 Home Assistant？",
            "description": "RoomMind {version} 已安装，但 Home Assistant 仍在运行旧版本。请重启以完成更新。"
          }
        }
      }
    },
    "outdoor_temp_unavailable": {
      "title": "室外温度不可用",
      "description": "由于室外传感器（{sensor}）和天气实体（{weather}）均未提供有效温度，RoomMind 已暂停热力学学习。"
    }
  },
  "entity": {
    "sensor": {
      "target_temperature": {
        "name": "{room} 目标温度"
      },
      "mode": {
        "name": "{room} 运行反馈"
      }
    },
    "binary_sensor": {
      "cover_paused": {
        "name": "{room} 窗帘控制已暂停"
      }
    },
    "switch": {
      "cover_auto": {
        "name": "{room} 窗帘自动控制"
      },
      "climate_control": {
        "name": "{room} 温控"
      },
      "global_climate_control": {
        "name": "全局温控开关"
      },
      "vacation_mode": {
        "name": "度假模式"
      }
    },
    "select": {
      "climate_mode": {
        "name": "{room} 运行模式",
        "state": {
          "auto": "自动智能",
          "cool_only": "制冷",
          "heat_only": "制热",
          "dry": "除湿",
          "fan_only": "送风",
          "off": "关闭"
        }
      }
    },
    "climate": {
      "override": {
        "name": "{room} 手动覆盖"
      },
      "comfort": {
        "name": "{room} 舒适目标",
        "state_attributes": {
          "preset_mode": {
            "state": {
              "schedule": "跟随房间策略",
              "hold": "保持温度"
            }
          }
        }
      }
    }
  }
}
