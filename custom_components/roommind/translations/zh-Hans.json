{
  "config": {
    "step": {
      "user": {
        "title": "RoomMind",
        "description": "设置 RoomMind 以管理房间温控。安装完成后，可在 RoomMind 面板中配置房间。"
      }
    },
    "abort": {
      "already_configured": "RoomMind 已经配置过了。"
    }
  },
  "issues": {
    "restart_required": {
      "title": "需要重启",
      "fix_flow": {
        "step": {
          "confirm_restart": {
            "title": "重启 Home Assistant？",
            "description": "RoomMind {version} 已安装，但 Home Assistant 仍在运行旧版本。请重启以完成更新。"
          }
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "target_temperature": {
        "name": "{room} 目标温度"
      },
      "mode": {
        "name": "{room} 模式"
      }
    },
    "binary_sensor": {
      "cover_paused": {
        "name": "{room} 窗帘控制已暂停"
      }
    },
    "switch": {
      "cover_auto": {
        "name": "{room} 窗帘自动控制"
      },
      "climate_control": {
        "name": "{room} 温控"
      },
      "vacation_mode": {
        "name": "度假模式"
      }
    },
    "climate": {
      "override": {
        "name": "{room} 手动覆盖"
      }
    }
  }
}
