{
  "config": {
    "step": {
      "user": {
        "title": "RoomMind",
        "description": "Configure RoomMind to manage room climate. Configure rooms in the RoomMind panel after setup."
      }
    },
    "abort": {
      "already_configured": "RoomMind is already configured."
    }
  },
  "issues": {
    "restart_required": {
      "title": "Restart required",
      "fix_flow": {
        "step": {
          "confirm_restart": {
            "title": "Restart Home Assistant?",
            "description": "RoomMind {version} has been installed but Home Assistant is still running an older version. Restart to complete the update."
          }
        }
      }
    },
    "outdoor_temp_unavailable": {
      "title": "Outdoor temperature unavailable",
      "description": "RoomMind has paused thermal learning because neither outdoor sensor ({sensor}) nor weather entity ({weather}) is delivering a temperature."
    }
  },
  "entity": {
    "sensor": {
      "target_temperature": {
        "name": "{room} target temperature"
      },
      "mode": {
        "name": "{room} observed activity"
      },
      "temperature": {
        "name": "{room} temperature"
      },
      "humidity": {
        "name": "{room} humidity"
      },
      "dew_point": {
        "name": "{room} dew point"
      },
      "mold_risk": {
        "name": "{room} mold risk",
        "state": {
          "ok": "OK",
          "warning": "Warning",
          "critical": "Critical"
        }
      }
    },
    "binary_sensor": {
      "cover_paused": {
        "name": "{room} cover paused"
      },
      "air_quality": {
        "name": "{room} air quality"
      }
    },
    "switch": {
      "cover_auto": {
        "name": "{room} cover auto"
      },
      "climate_control": {
        "name": "{room} climate control"
      },
      "global_climate_control": {
        "name": "Climate control"
      },
      "vacation_mode": {
        "name": "Vacation mode"
      }
    },
    "select": {
      "climate_mode": {
        "name": "{room} HVAC mode",
        "state": {
          "auto": "Auto",
          "cool_only": "Cool",
          "heat_only": "Heat",
          "dry": "Dry",
          "fan_only": "Fan",
          "off": "Off"
        }
      }
    },
    "climate": {
      "override": {
        "name": "{room} override"
      },
      "comfort": {
        "name": "{room} comfort",
        "state_attributes": {
          "preset_mode": {
            "state": {
              "schedule": "Follow room policy",
              "hold": "Hold temperature"
            }
          }
        }
      }
    }
  }
}
